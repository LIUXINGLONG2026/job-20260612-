{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "command": "npm run build",
    "watchPatterns": [
      "src/**/*",
      "api/**/*"
    ]
  },
  "deploy": {
    "startCommand": "node api/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000"
  },
  "domains": [
    "job-20260612.up.railway.app"
  ]
}